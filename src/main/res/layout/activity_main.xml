<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0B0B">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="IG Share"
            android:textColor="#F5F5F5"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Send Instagram posts, reels and carousels to people who aren't on Instagram — as real photos and videos in WhatsApp, Telegram or any chat app."
            android:textColor="#BDBDBD"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="How to use"
            android:textColor="#F5F5F5"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="1. In Instagram, open a post or reel and tap Share (or ⋯ → Share / Copy link).\n2. Pick IG Share from the share sheet — or paste the link below.\n3. IG Share downloads the video and every carousel page, then opens a share sheet so you can send the files to WhatsApp, Telegram, or anywhere else."
            android:textColor="#BDBDBD"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tvIgStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Instagram: not connected"
            android:textColor="#F5F5F5"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Instagram blocks most downloads unless you're logged in. Connect once — you log in on Instagram's own page, and the app keeps only a session cookie on this phone."
            android:textColor="#888888"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnIgConnect"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Connect Instagram" />

        <EditText
            android:id="@+id/etLink"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:hint="Paste an Instagram link here"
            android:inputType="textUri"
            android:singleLine="true"
            android:textColor="#F5F5F5"
            android:textColorHint="#888888"
            android:textSize="15sp" />

        <Button
            android:id="@+id/btnGo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Fetch &amp; share" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Works with public posts only. Your phone fetches the media directly from Instagram — no account, no login, nothing passes through a server of ours."
            android:textColor="#888888"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
